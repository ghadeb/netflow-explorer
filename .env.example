# Documentation-only addresses. Replace them with your deployment values.
# Source IPv4 addresses of the authorized NetFlow exporters.
FLOW_EXPORTERS=192.0.2.11,192.0.2.12
# Server addresses for NetFlow ingestion and the HTTPS dashboard.
NETFLOW_UDP_BIND=192.0.2.20
NETFLOW_WEB_BIND=192.0.2.20
# Certificate DNS name, when it differs from the web bind address.
TLS_VERIFY_HOST=
# Days of live SQLite retention before verified days can expire.
RETENTION_DAYS=30
# Comma-separated DNS resolvers for on-demand PTR lookups.
PTR_DNS=
# Docker volume for daily archives. Compose creates it by default.
# FLOW_ARCHIVE_VOLUME=fluxo-archives
