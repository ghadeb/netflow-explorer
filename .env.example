# IP de origem de cada exporter Cisco.
FLOW_EXPORTERS=192.0.2.11,192.0.2.12
# IPs do servidor para recepção NetFlow e consulta HTTPS.
NETFLOW_UDP_BIND=192.0.2.20
NETFLOW_WEB_BIND=192.0.2.20
# DNS do certificado, quando diferente do IPv4 NETFLOW_WEB_BIND.
TLS_VERIFY_HOST=
# Dias de consulta em SQLite antes de expirar os dias já arquivados.
RETENTION_DAYS=30
# Resolvedores DNS internos para PTR a pedido, separados por vírgulas.
PTR_DNS=
# Volume Docker para os arquivos diários. O Compose cria-o por omissão.
# FLOW_ARCHIVE_VOLUME=fluxo-archives
